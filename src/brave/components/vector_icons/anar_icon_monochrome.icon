// Monochrome Anar mark (sphere + diagonal ring + pomegranate crown) for
// theme-tinted UI surfaces (About menu, omnibox internal-page badge, etc.).
CANVAS_DIMENSIONS, 24,
// Crown
MOVE_TO, 8.6f, 6.2f,
LINE_TO, 9.8f, 1.8f,
LINE_TO, 12.0f, 4.8f,
LINE_TO, 14.2f, 1.8f,
LINE_TO, 15.4f, 6.2f,
CLOSE,
// Upper-left hemisphere (above diagonal ring)
MOVE_TO, 4.8f, 14.4f,
ARC_TO, 7.8f, 7.8f, 0, 0, 1, 18.0f, 7.6f,
LINE_TO, 4.8f, 14.4f,
CLOSE,
// Diagonal ring band
MOVE_TO, 2.2f, 17.5f,
LINE_TO, 20.0f, 5.8f,
LINE_TO, 21.8f, 7.6f,
LINE_TO, 4.0f, 19.3f,
CLOSE,
// Lower-right hemisphere (below diagonal ring)
MOVE_TO, 6.6f, 19.0f,
LINE_TO, 19.4f, 10.6f,
ARC_TO, 7.8f, 7.8f, 0, 0, 1, 6.6f, 19.0f,
CLOSE
