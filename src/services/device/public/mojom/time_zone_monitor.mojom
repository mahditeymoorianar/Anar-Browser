module device.mojom;

interface TimeZoneMonitor {
  // Add a client that will get notified on time zone changes. No throttling is
  // employed, as time zone changes are infrequent enough that there is no
  // realistic risk of flooding.
  AddClient(pending_remote<TimeZoneMonitorClient> client);

  // Overrides the time zone reported to all clients (existing and future)
  // with |zone_id| (an IANA time zone id, e.g. "America/Los_Angeles"),
  // instead of the real system time zone, until ClearTimeZoneOverride() is
  // called.
  SetTimeZoneOverride(string zone_id);

  // Clears an override set via SetTimeZoneOverride() and reverts to
  // reporting the real system time zone.
  ClearTimeZoneOverride();
};

interface TimeZoneMonitorClient {
  // Called on a time zone change. |tz_info| is the new time zone ID.
  OnTimeZoneChange(string tz_info);
};
